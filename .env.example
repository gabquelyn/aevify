# Copy to .env and fill in. Never commit real values.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://aevify:aevify@localhost:5432/aevify

# QDay Aevum Testnet (chain ID 44005). Take the RPC URL from the QDay wiki / starter kit.
AEVUM_RPC_URL=
AEVUM_CHAIN_ID=44005

# tUSD8 test stablecoin (ERC-20, 6 decimals) - already deployed by QDay
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Public URL of the web app (dashboard + hosted checkout + API)
NEXT_PUBLIC_APP_URL=http://localhost:3000
