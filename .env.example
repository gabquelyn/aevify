# Copy to .env (cp .env.example .env). Docker Compose passes these to every container.
# Never commit .env.
#
# Don't leave a variable present-but-empty: an empty value overrides the Hardhat keystore.
# Comment it out instead.

# QDay Aevum Testnet (chain ID 44005). Public endpoint, not a secret.
AEVUM_RPC_URL=https://rpc-test.qday.info
AEVUM_CHAIN_ID=44005

# tUSD8 test stablecoin (ERC-20, 6 decimals), already deployed by QDay.
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Deployer key. Prefer the encrypted Hardhat keystore (see DEPLOY.md step 4).
# Only uncomment this if you choose plain environment variables instead.
# AEVUM_DEPLOYER_PRIVATE_KEY=0x...

# The Aevify checkout contract. Fill in after deploying (DEPLOY.md step 8).
# AEVIFY_CHECKOUT_ADDRESS=0x...

# Public URL of the web app (dashboard + hosted checkout + API).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB connection string, e.g. from MongoDB Atlas (Connect -> Drivers).
# Used by the web app/API and the listener. Check it at http://localhost:3000/api/health
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aevify
