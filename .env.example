# Copy to .env (cp .env.example .env). Docker Compose passes these to every container.
# Never commit .env.
#
# Don't leave a variable present-but-empty: an empty value overrides the Hardhat keystore.
# Comment it out instead.

# --- App -------------------------------------------------------------------

# Public URL of the web app. Used in sign-in links, the Google callback and checkout links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session encryption secret. Required in production. Generate: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# --- Database ----------------------------------------------------------------

# MongoDB connection string, e.g. from MongoDB Atlas (Connect -> Drivers).
# Check it at http://localhost:3000/api/health
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aevify

# --- Sign-in: Google -----------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
# Both values are needed; the Google button only appears when both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Sign-in: email links via Brevo ----------------------------------------------
# Brevo -> Settings -> SMTP & API -> SMTP tab. Use the SMTP login and an SMTP KEY
# (not a Brevo API key). EMAIL_FROM must be a verified sender in Brevo.
# Without these, sign-in links are printed in the web logs instead (docker compose logs web).
# BREVO_SMTP_LOGIN=
# BREVO_SMTP_KEY=
# EMAIL_FROM=Aevify <no-reply@yourdomain.com>

# --- Aevum Testnet -------------------------------------------------------------

# Public endpoint, not a secret.
AEVUM_RPC_URL=https://rpc-test.qday.info
AEVUM_CHAIN_ID=44005

# tUSD8 test stablecoin (ERC-20, 6 decimals), already deployed by QDay.
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# The Aevify checkout contract. Fill in after deploying (DEPLOY.md step 8).
# AEVIFY_CHECKOUT_ADDRESS=0x...

# --- API keys for the contract roles (DEPLOY.md step 11) ------------------------
# Must be the private keys of the SIGNER and OPERATOR addresses you deployed with.
# /api/health tells you if they don't match the contract.
# The signer only signs (no gas). The operator sends transactions (needs tQDAY).
# AEVIFY_SIGNER_PRIVATE_KEY=0x...
# AEVIFY_OPERATOR_PRIVATE_KEY=0x...

# --- Listener (apps/listener) -------------------------------------------------------
# Uses MONGODB_URI, AEVUM_RPC_URL, AEVUM_CHAIN_ID, AEVIFY_CHECKOUT_ADDRESS and NEXT_PUBLIC_APP_URL
# from above. Optional tuning:
# LISTENER_POLL_MS=3000          # how often to check for new blocks
# LISTENER_CONFIRMATIONS=1       # blocks to wait before trusting an event
# LISTENER_START_BLOCK=          # first block to scan (default: 5,000 blocks back); set to the deploy block
# LISTENER_BATCH_BLOCKS=2000     # max blocks per log request

# --- Contract deployment (Hardhat, in Docker) ---------------------------------------
# Prefer the encrypted Hardhat keystore (DEPLOY.md step 4). Only uncomment this if you
# choose plain environment variables instead.
# AEVUM_DEPLOYER_PRIVATE_KEY=0x...
